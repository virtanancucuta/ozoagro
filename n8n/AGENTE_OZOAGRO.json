{
  "name": "AGENTE_OZOAGRO",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ozoagro-telegram",
        "options": {}
      },
      "id": "telegram-webhook",
      "name": "Telegram Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"ok\":true}"
      },
      "id": "respond-ok",
      "name": "Responder OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "jsCode": "// Extraer mensaje de Telegram\nconst body = $input.first().json.body || $input.first().json;\nconst message = body.message || body.edited_message;\n\nif (!message) {\n  return [{ json: { error: 'No message' } }];\n}\n\nconst chatId = message.chat.id.toString();\nconst text = message.text || '';\nconst fromName = message.from?.first_name || 'Usuario';\nconst isAudio = !!message.voice || !!message.audio;\nconst audioFileId = message.voice?.file_id || message.audio?.file_id || null;\n\nreturn [{\n  json: {\n    chatId,\n    text,\n    fromName,\n    isAudio,\n    audioFileId,\n    platform: 'telegram'\n  }\n}];"
      },
      "id": "extract-message",
      "name": "Extraer Mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "is-audio",
              "leftValue": "={{ $json.isAudio }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-audio",
      "name": "Es Audio?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [600, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/getFile?file_id={{ $json.audioFileId }}",
        "options": {}
      },
      "id": "get-file-path",
      "name": "Obtener Path Audio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [800, 200]
    },
    {
      "parameters": {
        "url": "=https://api.telegram.org/file/bot{{ $env.TELEGRAM_BOT_TOKEN }}/{{ $json.result.file_path }}",
        "options": { "response": { "response": { "responseFormat": "file" } } }
      },
      "id": "download-audio",
      "name": "Descargar Audio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1000, 200]
    },
    {
      "parameters": {
        "resource": "audio",
        "operation": "transcribe",
        "binaryPropertyName": "data",
        "options": { "language": "es" }
      },
      "id": "transcribe-audio",
      "name": "Transcribir Audio",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [1200, 200],
      "credentials": { "openAiApi": { "id": "openai-cred", "name": "OpenAI" } }
    },
    {
      "parameters": {
        "jsCode": "// Unir mensaje transcrito\nconst items = $input.all();\nconst original = items.find(i => i.json.chatId)?.json || {};\nconst transcription = items.find(i => i.json.text && !i.json.chatId)?.json?.text || '';\n\nreturn [{\n  json: {\n    ...original,\n    text: transcription || original.text,\n    wasAudio: true\n  }\n}];"
      },
      "id": "merge-transcription",
      "name": "Unir Transcripcion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1400, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/registrar_mensaje_entrante",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "p_telefono", "value": "={{ $json.chatId }}" },
            { "name": "p_nombre", "value": "={{ $json.fromName }}" },
            { "name": "p_contenido", "value": "={{ $json.text }}" },
            { "name": "p_rol", "value": "user" }
          ]
        },
        "options": {}
      },
      "id": "register-incoming",
      "name": "Registrar Entrante",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1600, 300]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.text }}",
        "hasOutputParser": false,
        "options": {
          "systemMessage": "=Eres Andres Castro, asesor ejecutivo de OZOAGRO Colombia.\n\n## Producto\nOZOAGRO es un bioinsecticida/biofungicida ecologico a base de aceite ozonificado.\n- 100% ecologico, sin residuos toxicos\n- Seguro para abejas y polinizadores\n- 25 anos de experiencia, 30.000 campesinos satisfechos\n\n## Precios (consultar con tool para precio actual)\n- Combo 1 Litro: $130.000 (200L solucion)\n- Combo 2 Litros: $250.000 (400L solucion)\n- Combo 3 Litros: $300.000 (600L solucion)\n- Envio GRATIS, Contraentrega\n\n## Flujo\n1. Saluda y pregunta nombre y ciudad\n2. Pregunta que cultivo maneja\n3. Explica problemas del cultivo que OZOAGRO resuelve\n4. Presenta productos y precios\n5. Cierra venta pidiendo: nombre, telefono, direccion, ciudad, combo\n6. Confirma datos y crea pedido\n\n## Reglas\n- Mensajes CORTOS (2-3 oraciones)\n- Una pregunta a la vez\n- Tuteo respetuoso colombiano\n- Nunca digas que eres IA\n- Solo creas pedidos en estado por_confirmar\n\n## Modo CEO\nSi el chat_id es el del CEO, puedes consultar pedidos, inventario, ventas, gastos, balance.\n\nChat ID actual: {{ $json.chatId }}\nNombre: {{ $json.fromName }}"
        }
      },
      "id": "agent-ozoagro",
      "name": "Agente OZOAGRO",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.9,
      "position": [1800, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": { "temperature": 0.7 }
      },
      "id": "openai-model",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [1800, 500],
      "credentials": { "openAiApi": { "id": "openai-cred", "name": "OpenAI" } }
    },
    {
      "parameters": {
        "jsCode": "// Parsear respuesta del agente\nconst output = $input.first().json.output || $input.first().json.text || '';\nconst chatId = $('Extraer Mensaje').first().json.chatId;\n\nreturn [{\n  json: {\n    chatId,\n    response: output\n  }\n}];"
      },
      "id": "parse-response",
      "name": "Parsear Respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "chat_id", "value": "={{ $json.chatId }}" },
            { "name": "text", "value": "={{ $json.response }}" }
          ]
        },
        "options": {}
      },
      "id": "send-telegram",
      "name": "Enviar Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/registrar_mensaje_saliente",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "p_telefono", "value": "={{ $json.chatId }}" },
            { "name": "p_contenido", "value": "={{ $json.response }}" },
            { "name": "p_rol", "value": "assistant" }
          ]
        },
        "options": {}
      },
      "id": "register-outgoing",
      "name": "Registrar Saliente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2400, 300]
    }
  ],
  "connections": {
    "Telegram Webhook": { "main": [[{ "node": "Responder OK", "type": "main", "index": 0 }, { "node": "Extraer Mensaje", "type": "main", "index": 0 }]] },
    "Extraer Mensaje": { "main": [[{ "node": "Es Audio?", "type": "main", "index": 0 }]] },
    "Es Audio?": {
      "main": [
        [{ "node": "Obtener Path Audio", "type": "main", "index": 0 }],
        [{ "node": "Unir Transcripcion", "type": "main", "index": 0 }]
      ]
    },
    "Obtener Path Audio": { "main": [[{ "node": "Descargar Audio", "type": "main", "index": 0 }]] },
    "Descargar Audio": { "main": [[{ "node": "Transcribir Audio", "type": "main", "index": 0 }]] },
    "Transcribir Audio": { "main": [[{ "node": "Unir Transcripcion", "type": "main", "index": 0 }]] },
    "Unir Transcripcion": { "main": [[{ "node": "Registrar Entrante", "type": "main", "index": 0 }]] },
    "Registrar Entrante": { "main": [[{ "node": "Agente OZOAGRO", "type": "main", "index": 0 }]] },
    "Agente OZOAGRO": { "main": [[{ "node": "Parsear Respuesta", "type": "main", "index": 0 }]] },
    "OpenAI Chat Model": { "ai_languageModel": [[{ "node": "Agente OZOAGRO", "type": "ai_languageModel", "index": 0 }]] },
    "Parsear Respuesta": { "main": [[{ "node": "Enviar Telegram", "type": "main", "index": 0 }]] },
    "Enviar Telegram": { "main": [[{ "node": "Registrar Saliente", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [],
  "triggerCount": 1,
  "variables": {
    "SUPABASE_URL": "https://vlcxeajnucdkwamcivgy.supabase.co",
    "SUPABASE_SERVICE_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZsY3hlYWpudWNka3dhbWNpdmd5Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4ODA2MjMyMywiZXhwIjoyMTAzNjM4MzIzfQ.TTenskULkfWt7YfEy9QSF8tCuGKX4Tof8ICWveePjnw",
    "TELEGRAM_BOT_TOKEN": "PENDIENTE_CREAR_BOT"
  }
}
