      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\ntry {\n  if (body.object !== 'whatsapp_business_account') { return []; }\n  const ch = (((body.entry || [])[0] || {}).changes || [])[0] || {};\n  const value = ch.value || {};\n  const msg = (value.messages || [])[0];\n  if (!msg) { return []; }\n  const contact = (value.contacts || [])[0] || {};\n  const t = msg.type;\n  let texto = '', es_audio = false, audio_id = '';\n  if (t === 'text') { texto = (msg.text || {}).body || ''; }\n  else if (t === 'audio') { es_audio = true; audio_id = (msg.audio || {}).id || ''; }\n  else { texto = '[Mensaje tipo ' + t + '. Pidele que escriba o envie audio.]'; }\n  return [{ json: { from: msg.from, nombre: (contact.profile || {}).name || '', tipo: t, message_id: msg.id, es_audio, audio_id, texto } }];\n} catch (e) { return []; }"
