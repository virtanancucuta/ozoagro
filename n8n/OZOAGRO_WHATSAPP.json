        "jsCode": "const raw = $input.first().json.output || $input.first().json.text || '';\nconst from = $('Extraer mensaje').item.json.from;\n\n// Detectar tags de media\nlet media = null;\nconst mediaMap = {\n  '[ENVIAR_IMAGEN]': 'imagen',\n  '[ENVIAR_VIDEO_PEPINO]': 'video_pepino',\n  '[ENVIAR_VIDEO_PAPAYA]': 'video_papaya',\n  '[ENVIAR_VIDEO_SANDIA]': 'video_sandia'\n};\nfor (const [tag, tipo] of Object.entries(mediaMap)) {\n  if (raw.includes(tag)) { media = tipo; break; }\n}\n\n// Limpiar tags del mensaje\nlet respuesta = raw;\nfor (const tag of Object.keys(mediaMap)) {\n  respuesta = respuesta.replace(tag, '').trim();\n}\n\nreturn [{ json: { from, respuesta, media } }];"
